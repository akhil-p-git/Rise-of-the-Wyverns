[node name="OpenGrave" type="Area2D" parent="Interactables"]
position = Vector2(70, 376)
collision_layer = 2
collision_mask = 0
monitoring = false
script = ExtResource("24_script")
prompt = "Examine"
message = "The grave has been dug open from below, not above. A hex-mark is burned into the cracked lid, fresh enough to smell. Among the spilled earth lies a scorched bone, and when you lift it, the mark is on it too."
