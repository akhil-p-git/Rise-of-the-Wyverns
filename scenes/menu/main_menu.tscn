[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/menu/main_menu.gd" id="1_menu"]
[ext_resource type="Theme" path="res://assets/ui/grim_theme.tres" id="2_theme"]
[ext_resource type="Texture2D" path="res://assets/intro/storm_sea.png" id="3_sea"]
[ext_resource type="Texture2D" path="res://assets/intro/storm_mask.png" id="4_mask"]
[ext_resource type="Shader" path="res://shaders/water.gdshader" id="5_water"]

[sub_resource type="ShaderMaterial" id="bg_water"]
shader = ExtResource("5_water")
shader_parameter/water_mask = ExtResource("4_mask")
shader_parameter/swell_pixels = 1.6
shader_parameter/speed = 0.9
shader_parameter/glint_amount = 0.03

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_menu")

